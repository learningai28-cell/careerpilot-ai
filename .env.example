VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# PostHog — error monitoring + analytics. Get these from your PostHog
# project settings after creating a free account at posthog.com.
# Leave unset for local dev; analytics.ts no-ops without a key.
VITE_POSTHOG_KEY=phc_your-project-api-key
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Set as an Edge Function secret, NOT here (this file is client-side only):
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...

# Google Ads conversion labels (the part after "AW-18378497668/" in the
# conversion snippet from Google Ads > Goals > Conversions). Leave unset to
# disable the respective conversion event.
VITE_GADS_SIGNUP_LABEL=
VITE_GADS_PURCHASE_LABEL=
